---
import type { CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";
import { getArchiveBuckets } from "@/utils/archive";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const locale = Astro.currentLocale ?? "zh";
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const buckets = getArchiveBuckets(posts);
---

{
  buckets.map(({ year, posts: yearPosts, months }) => (
    <div>
      <span class="text-2xl font-bold">{year}</span>{" "}
      <sup class="text-muted-foreground text-sm">{yearPosts.length}</sup>
      {months.map(({ month, posts: monthPosts }) => (
        <div class="flex flex-col sm:flex-row">
          <div class="mt-6 min-w-36 text-lg sm:my-6">
            <span class="font-bold">
              {monthFormatter.format(new Date(2000, Number(month) - 1, 1))}
            </span>{" "}
            <sup class="text-muted-foreground text-xs">{monthPosts.length}</sup>
          </div>
          <ul>
            {monthPosts.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  ))
}
