---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import { pageHref } from "@/utils/pagination";

type Props = {
  currentPage: number;
  lastPage: number;
  basePath: string;
};

const { currentPage, lastPage, basePath } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const prevHref = currentPage > 1 ? pageHref(basePath, currentPage - 1) : null;
const nextHref =
  currentPage < lastPage ? pageHref(basePath, currentPage + 1) : null;
---

{
  lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center gap-4"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!prevHref}
        href={prevHref ?? "#"}
        class:list={["select-none", { "opacity-50": !prevHref }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      {currentPage} / {lastPage}
      <LinkButton
        disabled={!nextHref}
        href={nextHref ?? "#"}
        class:list={["select-none", { "opacity-50": !nextHref }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
