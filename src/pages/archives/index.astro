---
import PostListPage from "@/components/compat/PostListPage.astro";
import { siteConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";
import { makePage } from "@/utils/compat-pagination";

const posts = await getSortedPosts();
const page = makePage(posts, 1, siteConfig.pagination.postsPerPage, "/archives");
---

<PostListPage page={page} basePath="/archives" title="归档" heading="归档" />
