---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ArchiveList from "@/components/ArchiveList.astro";
import Pager from "@/components/Pager.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { pageCount, slicePage } from "@/utils/pagination";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts.filter(postFilter));

const pageSize = config.posts.perPage;
const lastPage = pageCount(sortedPosts.length, pageSize);
const currentPage = 1;
const pagePosts = slicePage(sortedPosts, currentPage, pageSize);
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    <ArchiveList posts={pagePosts} />
  </Main>

  <Pager {currentPage} {lastPage} basePath="/archives" />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
