---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ArchiveList from "@/components/ArchiveList.astro";
import Pager from "@/components/Pager.astro";
import { getArchiveBuckets } from "@/utils/archive";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { pageCount, slicePage } from "@/utils/pagination";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const buckets = getArchiveBuckets(posts.filter(postFilter));

  return buckets.map(bucket => ({
    params: { year: bucket.year },
    props: { yearPosts: getSortedPosts(bucket.posts) },
  }));
}) satisfies GetStaticPaths;

type Props = {
  yearPosts: CollectionEntry<"posts">[];
};

const { yearPosts } = Astro.props;
const year = Astro.params.year!;

const pageSize = config.posts.perPage;
const lastPage = pageCount(yearPosts.length, pageSize);
const currentPage = 1;
const pagePosts = slicePage(yearPosts, currentPage, pageSize);
---

<Layout title={`${year} 年归档 | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={`${year} 年`} pageDesc={`${year} 年发布的 ${yearPosts.length} 篇文章`}>
    <ArchiveList posts={pagePosts} />
  </Main>

  <Pager {currentPage} {lastPage} basePath={`/archives/${year}`} />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
