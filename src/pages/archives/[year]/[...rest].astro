---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ArchiveList from "@/components/ArchiveList.astro";
import Pager from "@/components/Pager.astro";
import { getArchiveBuckets } from "@/utils/archive";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { pageCount, slicePage } from "@/utils/pagination";
import config from "@/config";

type PageProps = {
  title: string;
  desc: string;
  posts: CollectionEntry<"posts">[];
  currentPage: number;
  lastPage: number;
  basePath: string;
};

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const buckets = getArchiveBuckets(posts.filter(postFilter));
  const pageSize = config.posts.perPage;
  const paths: { params: { year: string; rest: string }; props: PageProps }[] =
    [];

  for (const bucket of buckets) {
    const yearPosts = getSortedPosts(bucket.posts);
    const yearBase = `/archives/${bucket.year}`;
    const yearLastPage = pageCount(yearPosts.length, pageSize);

    for (let page = 2; page <= yearLastPage; page++) {
      paths.push({
        params: { year: bucket.year, rest: `page/${page}` },
        props: {
          title: `${bucket.year} 年`,
          desc: `${bucket.year} 年发布的 ${yearPosts.length} 篇文章`,
          posts: slicePage(yearPosts, page, pageSize),
          currentPage: page,
          lastPage: yearLastPage,
          basePath: yearBase,
        },
      });
    }

    for (const monthBucket of bucket.months) {
      const monthPosts = getSortedPosts(monthBucket.posts);
      const month = monthBucket.month;
      const monthLabel = `${bucket.year} 年 ${Number(month)} 月`;
      const monthBase = `${yearBase}/${month}`;
      const monthLastPage = pageCount(monthPosts.length, pageSize);

      paths.push({
        params: { year: bucket.year, rest: month },
        props: {
          title: monthLabel,
          desc: `${monthLabel}发布的 ${monthPosts.length} 篇文章`,
          posts: slicePage(monthPosts, 1, pageSize),
          currentPage: 1,
          lastPage: monthLastPage,
          basePath: monthBase,
        },
      });

      for (let page = 2; page <= monthLastPage; page++) {
        paths.push({
          params: { year: bucket.year, rest: `${month}/page/${page}` },
          props: {
            title: monthLabel,
            desc: `${monthLabel}发布的 ${monthPosts.length} 篇文章`,
            posts: slicePage(monthPosts, page, pageSize),
            currentPage: page,
            lastPage: monthLastPage,
            basePath: monthBase,
          },
        });
      }
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { title, desc, posts, currentPage, lastPage, basePath } =
  Astro.props as PageProps;
---

<Layout title={`${title}归档 | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title} pageDesc={desc}>
    <ArchiveList {posts} />
  </Main>

  <Pager {currentPage} {lastPage} {basePath} />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
