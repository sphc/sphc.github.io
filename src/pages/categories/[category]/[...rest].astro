---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pager from "@/components/Pager.astro";
import { categorySlug } from "@/utils/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { pageCount, slicePage } from "@/utils/pagination";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const pageSize = config.posts.perPage;
  const names = new Map<string, string>();

  for (const post of posts.filter(postFilter)) {
    if (post.data.category) {
      names.set(categorySlug(post.data.category), post.data.category);
    }
  }

  const paths = [];
  for (const [slug, name] of names) {
    const categoryPosts = getSortedPosts(
      posts.filter(postFilter).filter(post => post.data.category === name)
    );
    const lastPage = pageCount(categoryPosts.length, pageSize);

    for (let page = 2; page <= lastPage; page++) {
      paths.push({
        params: { category: slug, rest: `page/${page}` },
        props: {
          categoryName: name,
          currentPage: page,
          lastPage,
          posts: slicePage(categoryPosts, page, pageSize),
        },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { categoryName, currentPage, lastPage, posts } = Astro.props as {
  categoryName: string;
  currentPage: number;
  lastPage: number;
  posts: CollectionEntry<"posts">[];
};

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const basePath = `/categories/${Astro.params.category}`;
---

<Layout
  title={`${t.pages.categoryTitle}: ${categoryName} | ${config.site.title}`}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.categoryTitle}: ${categoryName}`}
    pageDesc={`${t.pages.categoryDesc} "${categoryName}".`}
  >
    <ul>
      {posts.map(post => <Card {...post} />)}
    </ul>
  </Main>

  <Pager {currentPage} {lastPage} {basePath} />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
