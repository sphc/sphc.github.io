---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pager from "@/components/Pager.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { pageCount, slicePage } from "@/utils/pagination";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts.filter(postFilter));
  const lastPage = pageCount(sortedPosts.length, config.posts.perPage);

  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: { currentPage, lastPage },
    };
  });
}) satisfies GetStaticPaths;

const { currentPage, lastPage } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts.filter(postFilter));
const pagePosts = slicePage(sortedPosts, currentPage, config.posts.perPage);
---

<Layout title={`${t.pagination.page} ${currentPage} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout pb-4">
    <ul>
      {pagePosts.map(post => <Card {...post} />)}
    </ul>
  </main>

  <Pager {currentPage} {lastPage} basePath="" />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
