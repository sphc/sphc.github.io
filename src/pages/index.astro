---
import { getCollection } from "astro:content";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import Pager from "@/components/Pager.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { pageCount, slicePage } from "@/utils/pagination";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts.filter(postFilter));

const pageSize = postsConfig.perPage;
const lastPage = pageCount(sortedPosts.length, pageSize);
const currentPage = 1;
const pagePosts = slicePage(sortedPosts, currentPage, pageSize);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {config.site.title}
      </h1>{" "}
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>{config.site.description}</p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="recent-posts" class="pt-12 pb-6">
      <ul>
        {pagePosts.map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>

    <Pager currentPage={currentPage} lastPage={lastPage} basePath="" />
  </main>
  <Footer noMarginTop={lastPage > 1} />
</Layout>
